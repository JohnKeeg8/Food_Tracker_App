# Copy this file to .env and fill it in:  cp .env.example .env

# Your Anthropic API key, for the "Ask Claude" chat. Get one at https://console.anthropic.com
# Leave empty to hide the Ask Claude feature.
ANTHROPIC_API_KEY=

# Claude model used for the chat.
CLAUDE_MODEL=claude-opus-5-5

# Allow new people to create accounts. Set to false once your household has signed up.
ALLOW_SIGNUP=true

# Optional: require this code to create an account (recommended if the app is reachable from the internet).
SIGNUP_CODE=

# Port the app is published on (http://<server-ip>:APP_PORT).
APP_PORT=8080

# Only used with the optional HTTPS proxy (docker compose --profile https up -d):
# the IP address or hostname you type into your phone's browser.
SITE_ADDRESS=192.168.1.50
